# Comma-separated list of allowed CORS origins.
# Development default: localhost Vite dev servers (5173 / 5174 fallback).
# Production: set to your deployment origin(s), e.g. https://beam.example.com
# Never leave as * in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Backend port (default: 8000)
PORT=8000

# Log verbosity: DEBUG | INFO | WARNING | ERROR (default: INFO)
# BEAM_LOG_LEVEL=INFO
